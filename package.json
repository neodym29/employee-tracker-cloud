{
  "scripts": {
    "build:tracemini": "node scripts/build-tracemini.mjs",
    "test:tracemini": "npm run build:tracemini && node --test tests/tracemini-direct-source.test.mjs",
    "dev": "next dev",
    "build": "npm run build:tracemini && node scripts/extract-tracemini-install.mjs && next build",
    "start": "next start",
    "test": "npm run build:tracemini && node --test tests/*.test.mjs && (for f in tests/*test.py; do python3 \"$f\" -v || exit $?; done) && npm run test:postgres",
    "test:postgres": "node --test tests/postgres-embedded-gate.mjs",
    "test:project-agent-bridge": "node --test tests/project-agent-bridge.test.mjs",
    "project-agent-bridge": "node scripts/project-agent-bridge.mjs",
    "project-agent-bridge:smoke": "node scripts/project-agent-bridge-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "diff-check": "git diff --check",
    "lint": "next lint"
  },
  "dependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "next": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "esbuild": "0.28.2"
  }
}
