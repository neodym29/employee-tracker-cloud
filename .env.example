# Core server configuration
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TraceMini read-only project integration
# Generate exactly 32 random bytes, encoded as base64. Do not reuse AUTH_SECRET.
TRACEMINI_ENCRYPTION_KEY=
# Comma-separated exact origins. HTTPS is mandatory except loopback when NODE_ENV=development.
TRACEMINI_ALLOWED_ORIGINS=https://tracemini.example.com
