[Unit]
Description=Transparent employee activity logger
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/employee_tracker
Environment=PYTHONPATH=%h/Desktop/employee_tracker/src
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=EMPLOYEE_TRACKER_ENABLE_SCREENSHOTS=0
Environment=EMPLOYEE_TRACKER_WORKSPACE=%h/Desktop
Environment=EMPLOYEE_TRACKER_FILE_ROOTS=%h/Downloads:%h/Documents:%h/Desktop:%h/Pictures:%h/Music:%h/Videos
Environment=EMPLOYEE_TRACKER_FILE_SCAN_SECONDS=120
Environment=EMPLOYEE_TRACKER_PROCESS_SCAN_SECONDS=60
Environment=EMPLOYEE_TRACKER_STATE_SNAPSHOT_SECONDS=10
Environment=EMPLOYEE_TRACKER_POLL_SECONDS=2
Environment=EMPLOYEE_TRACKER_CLOUD_UPLOAD_SECONDS=5
ExecStart=/usr/bin/python3 -m employee_tracker.cli run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
